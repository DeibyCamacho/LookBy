# ==========================================
# LookBy - Variables de Entorno
# ==========================================

# Conexión a MongoDB (MongoDB Atlas o local)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/lookby?retryWrites=true&w=majority

# Credenciales de Administrador por defecto (para primer inicio)
ADMIN_EMAIL=admin@lookby.com
ADMIN_PASSWORD=admin123

# Secreto para firma de tokens JWT / Sesiones seguras
JWT_SECRET=super_secret_jwt_key_lookby_cambiar_en_produccion

# API Key de Resend (para envío de correos de recuperación de contraseña y avisos de citas)
RESEND_API_KEY=re_1234567890
