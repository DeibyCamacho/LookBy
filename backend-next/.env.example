# ==========================================
# LookBy - Variables de Entorno (Next.js)
# ==========================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local ni credenciales reales a Git.

# Conexión a MongoDB - Nuestra base propia (instancia local, con usuarios).
# En esta PC:  mongodb://lookby_user:<PASSWORD>@127.0.0.1:27018/lookby?authSource=admin
# Desde otra PC de la red:
#   mongodb://lookby_user:<PASSWORD>@<IP-de-la-PC>:27018/lookby?authSource=admin
#
# Si en el futuro se vuelve a usar Atlas, sustituir por:
#   mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/lookby?retryWrites=true&w=majority
MONGODB_URI=mongodb://lookby_user:<PASSWORD>@127.0.0.1:27018/lookby?authSource=admin

# Credenciales del superadministrador inicial (para el primer inicio)
ADMIN_EMAIL=admin@lookby.com
ADMIN_PASSWORD=admin123

# Secreto para firmar tokens JWT (cámbialo en producción)
JWT_SECRET=super_secret_jwt_key_lookby_cambiar_en_produccion

# API key de Resend (recuperación de contraseña / correos)
RESEND_API_KEY=re_1234567890